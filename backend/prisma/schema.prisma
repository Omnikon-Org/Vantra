datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  accounts            Account[]
  categories          Category[]
  merchants           Merchant[]
  transactions        Transaction[]
  ledgerEntries       LedgerEntry[]
  reconciliations     Reconciliation[]
  reconciliationItems ReconciliationItem[]
  auditLogs           AuditLog[]
  exceptions          ReconciliationException[]
  fraudAlerts         FraudAlert[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  name         String?
  role         String   @default("MEMBER")
  googleId     String?  @unique
  authProvider String   @default("LOCAL")
  tenantId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant              Tenant                    @relation(fields: [tenantId], references: [id])
  auditLogs           AuditLog[]
  resolvedExceptions  ReconciliationException[] @relation("ResolvedByUser")
  reviewedFraudAlerts FraudAlert[]              @relation("ReviewedByUser")
}

model Account {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  type      String   @default("BANK") // BANK, CREDIT, CASH
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  transactions    Transaction[]
  ledgerEntries   LedgerEntry[]
  reconciliations Reconciliation[]
}

model Category {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  type      String   @default("EXPENSE") // INCOME, EXPENSE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  transactions Transaction[]
}

model Merchant {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id            String   @id @default(uuid())
  tenantId      String
  accountId     String
  categoryId    String?
  merchantId    String?
  
  amount        Decimal
  currency      String   @default("USD")
  type          String   @default("EXPENSE") // INCOME, EXPENSE, TRANSFER
  description   String?
  reference     String?  @unique
  status        String   @default("PENDING") // PENDING, COMPLETED, FAILED, RECONCILED
  
  transactionAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant              Tenant                    @relation(fields: [tenantId], references: [id])
  account             Account                   @relation(fields: [accountId], references: [id])
  category            Category?                 @relation(fields: [categoryId], references: [id])
  merchant            Merchant?                 @relation(fields: [merchantId], references: [id])
  ledgerEntries       LedgerEntry[]
  reconciliationItems ReconciliationItem[]
  exceptions          ReconciliationException[]
  fraudAlerts         FraudAlert[]
}

model LedgerEntry {
  id            String   @id @default(uuid())
  tenantId      String
  accountId     String
  transactionId String
  amount        Decimal
  currency      String   @default("USD")
  entryType     String   // CREDIT or DEBIT
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  account     Account     @relation(fields: [accountId], references: [id])
  transaction Transaction @relation(fields: [transactionId], references: [id])
}

model Reconciliation {
  id                String   @id @default(uuid())
  tenantId          String
  accountId         String
  status            String   @default("COMPLETED") // PENDING, PROCESSING, COMPLETED, FAILED
  
  startDate         DateTime?
  endDate           DateTime?
  
  totalInternal     Int      @default(0)
  totalExternal     Int      @default(0)
  matchedCount      Int      @default(0)
  unmatchedCount    Int      @default(0)
  discrepancyCount  Int      @default(0)
  
  matchedAmount     Decimal  @default(0)
  discrepancyAmount Decimal  @default(0)
  
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant     Tenant                    @relation(fields: [tenantId], references: [id])
  account    Account                   @relation(fields: [accountId], references: [id])
  items      ReconciliationItem[]
  exceptions ReconciliationException[]
}

model ReconciliationItem {
  id                  String   @id @default(uuid())
  tenantId            String
  reconciliationId    String
  transactionId       String?
  
  externalReference   String?
  externalAmount      Decimal?
  externalDate        DateTime?
  externalDescription String?
  
  internalAmount      Decimal?
  
  matchType           String   @default("EXACT") // EXACT, FUZZY, MANUAL, DISCREPANCY, UNMATCHED
  status              String   @default("MATCHED") // MATCHED, UNMATCHED, DISCREPANT, RESOLVED
  
  discrepancyReason   String?
  discrepancyAmount   Decimal?
  confidenceScore     Decimal?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant         Tenant                    @relation(fields: [tenantId], references: [id])
  reconciliation Reconciliation            @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  transaction    Transaction?              @relation(fields: [transactionId], references: [id])
  exceptions     ReconciliationException[]
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  action     String   // e.g. ACCOUNT_CREATED, TRANSACTION_CREATED, RECONCILIATION_CREATED, EXCEPTION_RESOLVED, FRAUD_ALERT_CREATED
  entityType String   // e.g. Account, Transaction, Reconciliation, ReconciliationItem, ReconciliationException, FraudAlert
  entityId   String?
  metadata   Json?    // Non-sensitive context and audit metadata
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])
}

model ReconciliationException {
  id                   String    @id @default(uuid())
  tenantId             String
  reconciliationId     String
  reconciliationItemId String?
  transactionId        String?
  
  exceptionType        String    // AMOUNT_MISMATCH, UNMATCHED_EXTERNAL, UNMATCHED_INTERNAL, DESCRIPTION_MISMATCH
  severity             String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status               String    @default("OPEN")   // OPEN, IN_REVIEW, RESOLVED
  description          String
  
  resolutionNotes      String?
  resolvedAt           DateTime?
  resolvedById         String?
  
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  reconciliation     Reconciliation      @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  reconciliationItem ReconciliationItem? @relation(fields: [reconciliationItemId], references: [id], onDelete: SetNull)
  transaction        Transaction?        @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  resolvedBy         User?               @relation("ResolvedByUser", fields: [resolvedById], references: [id])
}

model FraudAlert {
  id            String    @id @default(uuid())
  tenantId      String
  transactionId String
  
  riskScore     Int       // 0 to 100
  severity      String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status        String    @default("OPEN")   // OPEN, IN_REVIEW, CONFIRMED, DISMISSED, RESOLVED
  
  reasons       String[]  // Human-readable explainable reasons
  ruleResults   Json      // Detailed results for each evaluated rule
  
  reviewedAt    DateTime?
  reviewedById  String?
  reviewNotes   String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  reviewedBy  User?       @relation("ReviewedByUser", fields: [reviewedById], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, severity])
  @@index([transactionId])
}
